---
/**
 * The evillevi wordmark: "evil" in Montserrat, "levi" in Lobster (the Evil
 * Labs brand script) in the accent color. With `text`, every "evillevi" in
 * the string becomes the wordmark and the rest renders as plain text.
 *
 * The orange accent on crema is 3.1:1, which passes only as large text, so
 * keep the wordmark at 24px or more. The visual halves are aria-hidden and
 * inline-flex (no gap between them); screen readers get the plain word.
 */
interface Props {
  text?: string;
  class?: string;
}

const { text = "evillevi", class: className } = Astro.props;
const parts = text.split(/(evillevi)/i);
---

<span class={className}>
  {
    parts.map((part, index) =>
      index % 2 === 1 ? (
        <>
          <span class="sr-only">evillevi</span>
          <span class="inline-flex items-baseline whitespace-nowrap" aria-hidden="true">
            <span class="font-extrabold">evil</span>
            <span class="font-brand text-primary pr-[0.06em] [font-size:1.22em] font-normal tracking-normal normal-case">
              levi
            </span>
          </span>
        </>
      ) : (
        part
      ),
    )
  }
</span>
