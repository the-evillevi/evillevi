---
import type { CollectionEntry } from "astro:content";
import VoxelPetVisual from "./VoxelPetVisual";

interface Props {
  entry: CollectionEntry<"projects">;
}

const { entry } = Astro.props;
const { title, description, tech, liveUrl, repoUrl } = entry.data;
const codeUrl = repoUrl ?? null;
---

<article class="evil-card flex w-[19rem] shrink-0 snap-start flex-col p-5 sm:w-[23rem]">
  <div
    class="rounded-control border-border bg-background mb-4 h-40 overflow-hidden border-2"
    aria-hidden="true"
  >
    {
      entry.id === "affogato" ? (
        <VoxelPetVisual client:visible modelPath="/models/animal-cat.glb" />
      ) : entry.id === "evillevi-garden" ? (
        <div class="grid h-full grid-rows-[auto_1fr] gap-2 p-3">
          {/* CSS-only mini mockup of the garden UI */}
          <div class="border-border bg-surface flex items-center gap-1.5 rounded-sm border-2 px-2 py-1">
            <span class="bg-primary size-3 rounded-full" />
            <span class="bg-foreground ml-1 h-2 w-12 rounded-full" />
            <span class="bg-muted-foreground ml-auto h-2 w-6 rounded-full" />
            <span class="bg-muted-foreground h-2 w-6 rounded-full" />
          </div>
          <div class="grid grid-cols-[1.4fr_1fr] gap-2">
            <div class="border-border bg-surface space-y-1.5 rounded-sm border-2 p-2">
              <div class="bg-foreground h-3 w-4/5 rounded-full" />
              <div class="bg-muted-foreground h-2 w-full rounded-full" />
              <div class="bg-muted-foreground h-2 w-3/4 rounded-full" />
              <div class="mt-2 flex gap-1">
                <span class="bg-primary h-3 w-8 rounded-sm" />
                <span class="border-border h-3 w-8 rounded-sm border-2" />
              </div>
            </div>
            <div class="border-border bg-surface grid grid-cols-2 gap-1 rounded-sm border-2 p-1">
              {Array.from({ length: 4 }).map((_, index) => (
                <span
                  class:list={[
                    "block rounded-xs",
                    index % 3 === 0 ? "bg-primary" : "bg-background",
                  ]}
                />
              ))}
            </div>
          </div>
        </div>
      ) : entry.id === "3d-chess" ? (
        <div class="relative grid h-full place-items-center overflow-hidden bg-[#262822]">
          {/* A thumbnail of gg³ in its own palette: the chess app is a POC that keeps its look. */}
          {[0, 1, 2].map((level) => (
            <div
              class="absolute grid size-24 grid-cols-8 border-2 border-[#aeb49e] shadow-lg"
              style={`transform: translateY(${(level - 1) * 30}px) rotateX(55deg) rotateZ(-30deg);`}
            >
              {Array.from({ length: 64 }, (_, i) => (
                <span
                  class="aspect-square"
                  style={`background: ${(i + Math.floor(i / 8)) % 2 ? "#e4dfcf" : "#77916c"}`}
                />
              ))}
            </div>
          ))}
          <span class="absolute right-4 bottom-2 text-5xl text-[#eee6d6]">♞</span>
        </div>
      ) : (
        <div class="grid h-full place-items-center bg-[repeating-linear-gradient(45deg,var(--evil-color-surface)_0_12px,var(--evil-color-background)_12px_24px)]">
          <span class="evil-tag">{title}</span>
        </div>
      )
    }
  </div>

  <h3 class="text-2xl">{title}</h3>
  <p class="text-muted-foreground mt-2 flex-1 text-sm leading-6">{description}</p>

  <div class="mt-3 flex flex-wrap gap-1.5">
    {tech.map((item) => <span class="evil-tag text-[0.625rem]">{item}</span>)}
  </div>

  <div class="mt-5 flex flex-wrap gap-2">
    <a class="evil-button evil-primary evil-sm" href={liveUrl}>View live demo</a>
    {
      codeUrl ? (
        <a class="evil-button evil-sm" href={codeUrl}>
          View code
        </a>
      ) : (
        <span
          class="evil-button evil-sm cursor-not-allowed opacity-60"
          title="Repository link pending"
        >
          Code soon
        </span>
      )
    }
  </div>
</article>
