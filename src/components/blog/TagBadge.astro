---
interface Props {
  tag: string;
  count?: number;
}

const { tag, count } = Astro.props;
---

<a href={`/tags/${tag}`} class="evil-tag hover:bg-primary hover:text-primary-foreground">
  <span>#{tag}</span>
  {typeof count === "number" && <span class="text-muted-foreground">{count}</span>}
</a>
