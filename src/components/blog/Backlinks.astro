---
import type { Backlink } from "@/utils/links";

interface Props {
  backlinks: Backlink[];
  currentEntryId: string;
}

const { backlinks, currentEntryId } = Astro.props;
---

<section class="evil-panel p-4">
  <h2 class="evil-label mb-3">Backlinks ({backlinks.length})</h2>
  <ul class="grid gap-3">
    {
      backlinks.map((link) => (
        <li class="rounded-control border-border bg-surface border-2 p-3">
          <a
            class="font-bold hover:underline hover:underline-offset-4"
            href={`${link.url}?locate=${currentEntryId}`}
          >
            {link.title}
          </a>
          {link.context && <p class="text-muted-foreground mt-1 text-sm">{link.context}</p>}
        </li>
      ))
    }
  </ul>
</section>
