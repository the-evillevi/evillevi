---
/* Evil Labs counterpart of components/layout/ShowcaseCard.astro. */
const { id, title } = Astro.props;
---

<article id={id} class="evil-card scroll-mt-24">
  <div
    class="mb-5 flex items-start justify-between gap-3 border-b-2 border-[var(--evil-color-border)] pb-3"
  >
    <h3>{title}</h3>
    <a class="evil-tag" href={`#${id}`}>#{id}</a>
  </div>
  <div class="space-y-4">
    <slot />
  </div>
</article>
