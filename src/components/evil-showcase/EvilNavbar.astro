---
import wordmark from "@/assets/evil-labs/wordmark-inline.svg?raw";
import { EVIL_FAMILIES } from "@/lib/evil-labs/friends";

const navItems = [
  { href: "#components", label: "Components" },
  { href: "#modes", label: "Modes" },
  { href: "#voxel-friends", label: "Friends" },
  { href: "#tokens", label: "Tokens" },
  { href: "#docs", label: "Docs" },
];

const modes = [
  { value: "system", label: "System" },
  { value: "light", label: "Light" },
  { value: "dark", label: "Dark" },
];
---

<header
  class="z-50 border-b-2 border-[var(--evil-color-border)] bg-[var(--evil-color-background)] md:sticky md:top-0"
>
  <nav
    class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3 px-4 py-3 md:px-6"
    aria-label="Showcase navigation"
  >
    <a class="evil-wordmark block w-36 shrink-0" href="#top" aria-label="Evil Labs, back to top">
      <Fragment set:html={wordmark} />
    </a>

    <div class="hidden items-center gap-1 lg:flex">
      {
        navItems.map((item) => (
          <a
            class="evil-label rounded-[var(--evil-radius-control)] px-3 py-2 hover:underline"
            href={item.href}
          >
            {item.label}
          </a>
        ))
      }
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <div
        class="evil-panel flex overflow-hidden p-0.5"
        role="radiogroup"
        aria-label="Color mode"
        data-evil-mode-control
      >
        {
          modes.map((mode) => (
            <button
              type="button"
              role="radio"
              aria-checked="false"
              class="evil-label rounded-[calc(var(--evil-radius-control)-2px)] px-3 py-1.5 aria-checked:bg-[var(--evil-color-accent)] aria-checked:text-[var(--evil-color-on-accent)]"
              data-mode={mode.value}
            >
              {mode.label}
            </button>
          ))
        }
      </div>
      <label class="sr-only" for="evil-family">Color family</label>
      <select
        id="evil-family"
        class="evil-panel evil-label h-10 bg-[var(--evil-color-surface)] px-2"
        data-evil-family-control
      >
        {EVIL_FAMILIES.map((family) => <option value={family.id}>{family.label}</option>)}
      </select>
    </div>
  </nav>
</header>
