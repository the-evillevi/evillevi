---
import "@/styles/starwind.css";
import { siteConfig } from "@/site.config";
import "@/components/chess/chess.css";

interface Props {
  title?: string;
  description?: string;
}

const title = Astro.props.title ? `${Astro.props.title} • ${siteConfig.title}` : siteConfig.title;
const description = Astro.props.description ?? siteConfig.description;
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.title} href="/rss.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const savedTheme = localStorage.getItem("nb-theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = savedTheme || (prefersDark ? "dark" : "light");
        document.documentElement.dataset.theme = theme;
        document.documentElement.classList.toggle("dark", theme === "dark");
      })();
    </script>
  </head>
  <body>
    <div class="chess-shell flex min-h-screen flex-col">
      <a
        href="#main-content"
        class="sr-only z-50 focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:border-4 focus:border-[var(--nb-ink)] focus:bg-[var(--nb-yellow)] focus:px-4 focus:py-3 focus:font-black focus:text-[var(--nb-button-text)] focus:uppercase"
      >
        Skip to content
      </a>
      <header class="chess-site-header">
        <nav aria-label="Primary navigation">
          <a href="/">evillevi / garden</a>
          <div>
            <a href="/projects">Projects</a>
            <a href="/projects/3d-chess/rules/">Rules</a>
            <button type="button" data-theme-toggle aria-label="Toggle theme">
              <span data-theme-icon>☀</span>
            </button>
          </div>
        </nav>
      </header>

      <main id="main-content" class="flex-1">
        <slot />
      </main>

      <footer class="chess-site-footer">
        <a href="/projects">Part of the garden</a> · Three levels, two distinct rulesets.
      </footer>
    </div>
    <script is:inline>
      const applyTheme = (theme) => {
        document.documentElement.dataset.theme = theme;
        document.documentElement.classList.toggle("dark", theme === "dark");
        localStorage.setItem("nb-theme", theme);
        document.querySelectorAll("[data-theme-icon]").forEach((icon) => {
          icon.textContent = theme === "dark" ? "☾" : "☀";
        });
      };

      const setupTheme = () => {
        applyTheme(document.documentElement.dataset.theme || "light");
        document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
          if (button.dataset.bound === "true") return;
          button.dataset.bound = "true";
          button.addEventListener("click", () => {
            applyTheme(document.documentElement.dataset.theme === "dark" ? "light" : "dark");
          });
        });
      };

      setupTheme();
      document.addEventListener("astro:after-swap", setupTheme);
    </script>
  </body>
</html>
