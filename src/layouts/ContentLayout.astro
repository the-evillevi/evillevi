---
import type { MarkdownHeading } from "astro";
import type { ContentEntry } from "@/utils/content";
import { entryHref, formatDate } from "@/utils/content";
import type { Backlink, ContentLink } from "@/utils/links";
import "katex/dist/katex.min.css";
import GardenLayout from "@/layouts/GardenLayout.astro";
import Backlinks from "@/components/blog/Backlinks.astro";
import GiscusComments from "@/components/blog/GiscusComments.astro";
import GraphView from "@/components/blog/GraphView.astro";
import OutgoingLinks from "@/components/blog/OutgoingLinks.astro";
import TagBadge from "@/components/blog/TagBadge.astro";

interface Props {
  entry: ContentEntry;
  headings: MarkdownHeading[];
  backlinks?: Backlink[];
  outgoingLinks?: ContentLink[];
}

const { entry, headings, backlinks = [], outgoingLinks = [] } = Astro.props;
const pageDate = entry.collection === "blog" ? entry.data.publishDate : entry.data.publishDate;
---

<GardenLayout title={entry.data.title} description={entry.data.description}>
  <article
    class="mx-auto grid max-w-7xl gap-8 px-4 py-10 md:px-6 lg:grid-cols-[minmax(0,1fr)_320px]"
  >
    <div class="min-w-0">
      <header class="border-border mb-10 border-b-2 pb-8">
        <a class="evil-tag evil-primary mb-4" href={`/${entry.collection}`}>
          {entry.collection}
        </a>
        <h1 class="evil-display max-w-4xl">{entry.data.title}</h1>
        <p class="text-muted-foreground mt-4 max-w-3xl text-lg">{entry.data.description}</p>
        <div class="mt-5 flex flex-wrap items-center gap-2">
          {pageDate && <span class="evil-meta">{formatDate(pageDate)}</span>}
          {
            entry.data.updatedDate && (
              <span class="evil-meta">Updated {formatDate(entry.data.updatedDate)}</span>
            )
          }
          {entry.data.tags.map((tag) => <TagBadge {tag} />)}
        </div>
      </header>

      <div id="content" class="evil-prose">
        <slot />
      </div>

      <section id="relations" class="mt-10 grid gap-5">
        {outgoingLinks.length > 0 && <OutgoingLinks links={outgoingLinks} />}
        {
          backlinks.length > 0 && (
            <Backlinks backlinks={backlinks} currentEntryId={`${entry.collection}/${entry.id}`} />
          )
        }
      </section>

      {entry.data.comment && <GiscusComments />}
    </div>

    <aside class="grid h-fit gap-5 lg:sticky lg:top-6">
      {
        headings.length > 0 && (
          <section class="evil-panel p-4">
            <h2 class="evil-label mb-3">Table of contents</h2>
            <nav class="grid gap-2 text-sm font-semibold">
              {headings
                .filter((heading) => heading.depth <= 3)
                .map((heading) => (
                  <a
                    class:list={[
                      "hover:underline hover:underline-offset-4",
                      heading.depth === 3 && "text-muted-foreground pl-4",
                    ]}
                    href={`#${heading.slug}`}
                  >
                    {heading.text}
                  </a>
                ))}
            </nav>
          </section>
        )
      }
      <GraphView currentSlug={`${entry.collection}/${entry.id}`} />
      <a class="evil-button" href={entryHref(entry)}> Permalink </a>
    </aside>
  </article>

  <script>
    import("@/components/scripts/wikilink-preview").catch((error) => {
      console.error("Failed to load wikilink previews", error);
    });
  </script>
</GardenLayout>
