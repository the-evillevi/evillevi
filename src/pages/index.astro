---
import { getCollection } from "astro:content";
import PostCard from "@/components/blog/PostCard.astro";
import TagBadge from "@/components/blog/TagBadge.astro";
import ProjectCard from "@/components/home/ProjectCard.astro";
import Accent3D from "@/components/three/Accent3D.astro";
import GardenLayout from "@/layouts/GardenLayout.astro";
import { siteConfig } from "@/site.config";
import { getAllTags, getBlogPosts, getDocsEntries } from "@/utils/content";

const posts = await getBlogPosts();
const docs = await getDocsEntries();
const tags = getAllTags([...posts, ...docs]).slice(0, 10);
const featuredProjects = (await getCollection("projects", ({ data }) => data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<GardenLayout>
  <section class="border-border border-b-2 px-4 py-12 md:px-6 md:py-20">
    <div class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">
      <div>
        <p class="evil-tag evil-primary mb-5">Personal knowledge base</p>
        <h1 class="evil-display max-w-4xl">Notes with sharp edges and visible links.</h1>
        <p class="text-muted-foreground mt-6 max-w-3xl text-xl">
          {siteConfig.description}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="evil-button evil-primary" href="/blog">Read blog</a>
          <a class="evil-button" href="/docs">Open docs</a>
        </div>
      </div>
      <div class="grid gap-2">
        <Accent3D shape="torus" color="peach" size="9rem" class="justify-self-end max-lg:hidden" />
        <div class="evil-card grid gap-4 p-5">
          <p class="evil-label text-primary">Garden stats</p>
          <div class="grid grid-cols-3 gap-3">
            {
              [
                [posts.length, "Posts"],
                [docs.length, "Docs"],
                [tags.length, "Tags"],
              ].map(([value, label]) => (
                <div class="evil-panel p-3 text-center">
                  <p class="text-4xl font-extrabold">{value}</p>
                  <p class="evil-label text-xs">{label}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-border bg-surface border-b-2 py-10 md:py-14">
    <div class="mx-auto max-w-7xl px-4 md:px-6">
      <h2 class="mb-6">Featured projects</h2>
    </div>
    <div class="mx-auto max-w-7xl px-4 md:px-6">
      <div class="flex snap-x snap-mandatory gap-6 overflow-x-auto px-1 pt-1 pb-5">
        {featuredProjects.map((entry) => <ProjectCard {entry} />)}
      </div>
      <a class="evil-label mt-4 inline-block underline underline-offset-4" href="/projects">
        View all experiments &amp; archived projects &rarr;
      </a>
    </div>
  </section>

  <section
    class="mx-auto grid max-w-7xl gap-8 px-4 py-10 md:px-6 lg:grid-cols-[minmax(0,1fr)_360px]"
  >
    <div>
      <div class="mb-6 flex items-end justify-between gap-4">
        <h2>Recent posts</h2>
        <a class="evil-label underline underline-offset-4" href="/blog">All posts</a>
      </div>
      <div class="grid gap-5 md:grid-cols-2">
        {posts.slice(0, 4).map((entry) => <PostCard {entry} headingLevel={3} />)}
      </div>
    </div>

    <aside class="grid h-fit gap-5">
      <section class="evil-panel p-4">
        <h2 class="evil-label mb-3">Tags</h2>
        <div class="flex flex-wrap gap-2">
          {tags.map(({ tag, count }) => <TagBadge {tag} {count} />)}
        </div>
      </section>
    </aside>
  </section>
</GardenLayout>
