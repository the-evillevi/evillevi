---
import GardenLayout from "@/layouts/GardenLayout.astro";
import PageHeader from "@/components/garden/PageHeader.astro";
import { entryHref, formatDate, getBlogPosts } from "@/utils/content";

const posts = await getBlogPosts();
---

<GardenLayout title="Archives" description="Chronological blog archive">
  <section class="mx-auto max-w-5xl px-4 py-10 md:px-6">
    <PageHeader title="Archives" description="Every post, newest first." />
    <ol class="grid gap-4">
      {
        posts.map((post) => (
          <li class="evil-card flex flex-col gap-2 p-4 md:flex-row md:items-center md:justify-between">
            <a
              class="text-xl font-extrabold hover:underline hover:underline-offset-4"
              href={entryHref(post)}
            >
              {post.data.title}
            </a>
            <time class="evil-meta" datetime={post.data.publishDate.toISOString()}>
              {formatDate(post.data.publishDate)}
            </time>
          </li>
        ))
      }
    </ol>
  </section>
</GardenLayout>
