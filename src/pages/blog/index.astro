---
import PostCard from "@/components/blog/PostCard.astro";
import GardenLayout from "@/layouts/GardenLayout.astro";
import PageHeader from "@/components/garden/PageHeader.astro";
import { getBlogPosts } from "@/utils/content";

const posts = await getBlogPosts();
---

<GardenLayout title="Blog" description="All blog posts">
  <section class="mx-auto max-w-7xl px-4 py-10 md:px-6">
    <PageHeader title="Blog" description="Field notes, experiments, and connected essays." />
    <div class="grid gap-5 md:grid-cols-2">
      {posts.map((entry) => <PostCard {entry} />)}
    </div>
  </section>
</GardenLayout>
