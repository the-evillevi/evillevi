---
import GardenLayout from "@/layouts/GardenLayout.astro";
import PageHeader from "@/components/garden/PageHeader.astro";
import { getAllTags, getBlogPosts, getDocsEntries } from "@/utils/content";

const entries = [...(await getBlogPosts()), ...(await getDocsEntries())];
const tags = getAllTags(entries);
---

<GardenLayout title="Tags" description="Browse notes by tag">
  <section class="mx-auto max-w-7xl px-4 py-10 md:px-6">
    <PageHeader
      title="Tags"
      description="Every topic in the garden, with how many notes carry it."
    />
    <div class="flex flex-wrap gap-3">
      {
        tags.map(({ tag, count }) => (
          <a class="evil-button" href={`/tags/${tag}`}>
            #{tag}
            <span class="text-muted-foreground">{count}</span>
          </a>
        ))
      }
    </div>
  </section>
</GardenLayout>
