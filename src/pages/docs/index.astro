---
import PostCard from "@/components/blog/PostCard.astro";
import GardenLayout from "@/layouts/GardenLayout.astro";
import PageHeader from "@/components/garden/PageHeader.astro";
import { getDocsEntries } from "@/utils/content";

const docs = await getDocsEntries();
---

<GardenLayout title="Docs" description="Knowledge-base documents">
  <section class="mx-auto max-w-7xl px-4 py-10 md:px-6">
    <PageHeader title="Docs" description="Evergreen notes and operating manuals." />
    <div class="grid gap-5 md:grid-cols-2">
      {docs.map((entry) => <PostCard {entry} />)}
    </div>
  </section>
</GardenLayout>
