---
import { AffogatoApp } from "@/components/affogato/AffogatoApp";
import GardenLayout from "@/layouts/GardenLayout.astro";

const description =
  "Affogato is a local-first Pomodoro timer with tasks, stats, bean rewards, and unlockable voxel cube friends.";
---

<GardenLayout title="Affogato - Voxel Pomodoro Timer" description={description}>
  <noscript>
    <p class="evil-card mx-auto my-8 max-w-3xl p-5 text-center font-bold">
      Affogato needs JavaScript to run the timer and track your beans.
    </p>
  </noscript>
  <AffogatoApp client:load />
  <section class="mx-auto grid max-w-5xl gap-8 px-4 pt-4 pb-16 sm:px-6 lg:grid-cols-3 lg:px-8">
    <article class="evil-card p-5">
      <h2 class="text-xl font-extrabold">What is Affogato?</h2>
      <p class="text-muted-foreground mt-3 text-sm leading-6">
        Affogato is a focused work timer that pairs Pomodoro sessions with simple task tracking,
        local stats, and a bean balance that grows while you stay on the clock.
      </p>
    </article>
    <article class="evil-card p-5">
      <h2 class="text-xl font-extrabold">How Pomodoro Works</h2>
      <p class="text-muted-foreground mt-3 text-sm leading-6">
        Choose one task, work for a focused interval, take a short break, and repeat. After a few
        rounds, take a longer break before starting the next cycle.
      </p>
    </article>
    <article class="evil-card p-5">
      <h2 class="text-xl font-extrabold">Cube Friends</h2>
      <p class="text-muted-foreground mt-3 text-sm leading-6">
        Every minute on the clock earns beans. Spend them in the friends panel to unlock new voxel
        companions — from a humble chick to a majestic panda — who hang out in the timer scene.
      </p>
    </article>
  </section>
</GardenLayout>
