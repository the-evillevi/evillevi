---
import { getCollection } from "astro:content";
import GardenLayout from "@/layouts/GardenLayout.astro";

/* Live-demo host for projects without their own app page. Static routes
 * (e.g. projects/affogato/index.astro) win over this dynamic route, so
 * only entries flagged demoPage generate here. */
export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => data.demoPage);
  return projects.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, valueProp, repoUrl } = entry.data;
---

<GardenLayout title={title} description={entry.data.description}>
  <section class="border-border bg-background border-b-2 px-4 py-8 md:px-6">
    <div class="mx-auto flex max-w-7xl flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="evil-display">{title}</h1>
        <p class="text-muted-foreground mt-2 max-w-2xl text-base font-bold">{valueProp}</p>
      </div>
      <div class="flex flex-wrap gap-2">
        {
          repoUrl ? (
            <a class="evil-button" href={repoUrl}>
              GitHub Repository
            </a>
          ) : (
            <span class="evil-button cursor-not-allowed opacity-60" title="Repository link pending">
              Code soon
            </span>
          )
        }
        <a class="evil-button evil-primary" href="/projects"> Read the deep dive &rarr; </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-10 md:px-6">
    <div
      class="rounded-control border-border grid min-h-[28rem] place-items-center border-2 border-dashed bg-[repeating-linear-gradient(45deg,var(--evil-color-surface)_0_16px,var(--evil-color-background)_16px_32px)] p-8 text-center"
    >
      <div class="evil-card max-w-xl p-6">
        <p class="evil-label">Live demo area</p>
        <p class="text-muted-foreground mt-3 text-sm leading-6 font-bold">
          [LIVE_DEMO: the main interactive application/canvas interface renders here — replace this
          placeholder with the project's island, e.g. &lt;ProjectApp client:load /&gt;]
        </p>
      </div>
    </div>
  </section>
</GardenLayout>
