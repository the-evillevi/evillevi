---
import "reveal.js/reveal.css";
import { getCollection, render } from "astro:content";
import GardenLayout from "@/layouts/GardenLayout.astro";
import Wordmark from "@/components/garden/Wordmark.astro";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(
  projects.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
const padded = (value: number) => String(value).padStart(2, "0");

const description =
  "A 2D presentation of selected work: navigate left/right to explore projects, down to inspect the technical deep dives.";

// Deck chrome uses the garden's Evil Labs classes (garden.css) in the markup;
// only the DOM reveal.js generates is styled in the global block below.
const chip = "evil-tag px-3 py-1 text-[15px]";
---

<GardenLayout title="Projects" description={description}>
  <section class="border-border bg-background border-b-2">
    <div id="projects-deck" class="reveal" tabindex="0" aria-label="Projects presentation">
      <div class="slides">
        <!-- ============================================================
             SLIDE 1 — INTRO (no vertical children)
             ============================================================ -->
        <section>
          <span class={`${chip} evil-primary mb-4`}>Portfolio · 2026</span>
          <h1>Selected Work</h1>
          <p class="tagline">A guided tour of things I've designed, built, and shipped.</p>
          <div class="my-6 flex flex-wrap justify-center gap-3">
            <span class={chip}>→ Left / Right · Explore projects</span>
            <span class={chip}>↓ Down · Inspect the deep dive</span>
            <span class={chip}>ESC · Bird's-eye overview</span>
          </div>
          <p class="text-muted-foreground">Use the arrows, your keyboard, or swipe.</p>
        </section>

        <!-- ============================================================
             ONE COLUMN PER PROJECT — overview card (↓ deep dive renders
             the project's MDX body). Driven by the content collection.
             ============================================================ -->
        {
          rendered.map(({ entry, Content }, index) => (
            <section>
              {/* Overview card */}
              <section class="relative">
                <span class={`${chip} evil-primary mb-4`}>Project {padded(index + 1)}</span>
                <h2>
                  <Wordmark text={entry.data.title} />
                </h2>
                <p class="tagline">{entry.data.valueProp}</p>
                <div class="my-6 flex flex-wrap justify-center gap-2">
                  {entry.data.tech.map((item) => (
                    <span class={chip}>{item}</span>
                  ))}
                </div>
                <div class="my-6 flex flex-wrap justify-center gap-3">
                  <a
                    class="evil-button evil-primary text-base"
                    href={entry.data.liveUrl}
                    target="_blank"
                    rel="noopener"
                  >
                    Live App
                  </a>
                  {entry.data.repoUrl ? (
                    <a
                      class="evil-button text-base"
                      href={entry.data.repoUrl}
                      target="_blank"
                      rel="noopener"
                    >
                      GitHub
                    </a>
                  ) : (
                    <span
                      class="evil-button cursor-not-allowed text-base opacity-60"
                      title="Repository link pending"
                    >
                      Code soon
                    </span>
                  )}
                </div>
                <span
                  class="evil-button evil-primary absolute bottom-[-130px] left-1/2 -translate-x-1/2 animate-bounce text-[15px] whitespace-nowrap motion-reduce:animate-none"
                  aria-hidden="true"
                >
                  <span class="text-[22px] leading-none">↓</span> Deep dive available
                </span>
              </section>

              {/* Deep dive — the project's MDX body, scrollable inside the slide */}
              <section>
                <div class="evil-card mx-auto max-h-[640px] w-full max-w-3xl overflow-y-auto p-6 text-left md:p-8">
                  <p class="evil-label text-muted-foreground">
                    <span class="normal-case">{entry.data.title}</span> · Deep dive
                  </p>
                  <div class="evil-prose mt-3 text-base">
                    <Content />
                  </div>
                </div>
              </section>
            </section>
          ))
        }
      </div>
    </div>
  </section>
</GardenLayout>

<script>
  import Reveal from "reveal.js";

  function initDeck() {
    const element = document.querySelector<HTMLElement>("#projects-deck");
    if (!element || element.dataset.bound === "true") return;
    element.dataset.bound = "true";

    const deck = new Reveal(element, {
      embedded: true,
      // Keyboard binds once the deck has focus (click/tab into it); the
      // native arrows and touch always work.
      keyboardCondition: "focused",
      hash: false,
      // Navigation & UI indicators
      controls: true,
      controlsTutorial: true, // pulses the ↓ arrow when a slide has children
      controlsLayout: "bottom-right",
      controlsBackArrows: "visible",
      progress: true,
      slideNumber: "h/v",
      overview: true,
      touch: true,
      // 2D grid: left/right = projects, down = that project's case study
      navigationMode: "grid",
      transition: "slide",
      backgroundTransition: "none",
      width: 1280,
      height: 800,
      margin: 0.08,
    });
    deck.initialize();
  }

  initDeck();
  document.addEventListener("astro:after-swap", initDeck);
</script>

<style is:global>
  /* ------------------------------------------------------------------
     Minimal reveal.js theming. Only targets DOM that reveal.js *generates*
     (and therefore can't carry Tailwind classes): the .reveal root, the
     progress bar, the arrow controls, and the slide-number badge, plus the
     shared heading typography. Everything else is Tailwind and the garden's
     Evil Labs classes in the markup. Colors are Evil Labs tokens.
     ------------------------------------------------------------------ */
  #projects-deck.reveal {
    /* Height must live here, not in a Tailwind utility: reveal adds the
       reveal-viewport class on init, and reveal.css's unlayered
       .reveal-viewport { height: 100% } beats anything in @layer utilities.
       The ID selector out-specifies it. */
    height: 100svh;
    font-family: var(--evil-font-family-body);
    font-size: 30px;
    font-weight: 500;
    line-height: 1.6;
    color: var(--evil-color-text);
    background: var(--evil-color-background);
  }
  #projects-deck h1,
  #projects-deck h2,
  #projects-deck h3 {
    color: var(--evil-color-text);
    font-family: var(--evil-font-family-body);
    font-weight: var(--evil-font-weight-extrabold);
    letter-spacing: -0.01em;
    margin: 0 0 24px;
  }
  #projects-deck h1 {
    font-size: clamp(48px, 8vw, 96px);
    line-height: 1;
  }
  #projects-deck h2 {
    font-size: 56px;
    line-height: 1.1;
  }
  #projects-deck .tagline {
    font-size: 32px;
    color: var(--evil-color-text-muted);
    margin-bottom: 8px;
  }
  #projects-deck :focus-visible {
    outline: var(--evil-focus-width) solid var(--evil-color-focus);
    outline-offset: var(--evil-focus-offset);
  }

  /* Progress bar: accent fill on a bordered track */
  #projects-deck .progress {
    height: 8px;
    background: var(--evil-color-surface);
    border-top: var(--evil-border-width) solid var(--evil-color-border);
    color: var(--evil-color-accent);
  }
  #projects-deck .progress span {
    background: var(--evil-color-accent);
  }

  #projects-deck .controls {
    color: var(--evil-color-accent);
    bottom: 32px;
    right: 32px;
  }

  #projects-deck .slide-number {
    right: auto;
    left: 16px;
    bottom: 24px;
    padding: 4px 10px;
    font-family: var(--evil-font-family-body);
    font-size: 12px;
    font-weight: var(--evil-font-weight-semibold);
    letter-spacing: 0.06em;
    color: var(--evil-color-text);
    background: var(--evil-color-surface);
    border: var(--evil-border-width) solid var(--evil-color-border);
    border-radius: var(--evil-radius-control);
  }
</style>
